# ---- Dependensi & build (dipasang ulang lewat composer/npm) ----
/node_modules
/vendor
/public/build
/public/hot
/public/storage

# ---- Rahasia: JANGAN pernah di-commit ----
.env
.env.*
!.env.example
auth.json
/storage/*.key
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.ovpn

# Konfigurasi deploy/upload editor (bisa berisi host, user, password, private key)
.vscode-upload.json
sftp.json
.ftpconfig
deploy.php
Homestead.json
Homestead.yaml

# ---- Database & backup (berisi data client & hash password) ----
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
/backup*/

# ---- Upload pengguna (foto, bukti bayar, video) ----
# Juga dijaga oleh storage/app/.gitignore & storage/app/public/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

# ---- Log, cache, laporan tes ----
*.log
npm-debug.log
yarn-error.log
.phpunit.result.cache
/.phpunit.cache
/coverage

# ---- Editor & OS ----
/.fleet
/.idea
/.vscode
.DS_Store
Thumbs.db
desktop.ini
